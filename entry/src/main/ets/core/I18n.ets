export class I18n {
  private static currentLocale: string = 'zh-CN';

  static load(): void {
    const saved: string = AppConfig.getString(KEYS.LANGUAGE, 'zh-CN');
    I18n.currentLocale = I18n.normalize(saved);
    AppStorage.setOrCreate('appLocale', I18n.currentLocale);
    AppStorage.setOrCreate(STORE_KEYS.localeRev, 0);
  }

  static locale(): string {
    return I18n.currentLocale;
  }

  static setLocale(locale: string): void {
    I18n.currentLocale = I18n.normalize(locale);
    AppStorage.setOrCreate('appLocale', I18n.currentLocale);
    I18n.bumpLocaleRev();
    AppConfig.setString(KEYS.LANGUAGE, I18n.currentLocale);
  }

  static t(key: string): string {
    return I18n.tx(I18n.currentLocale, key);
  }

  static tx(locale: string, key: string): string {
    const table: Record<string, string> = I18n.tableOf(I18n.normalize(locale));
    const hit: string = table[key];
    if (hit !== undefined && hit.length > 0) {
      return hit;
    }
    const fallback: string = ZH_CN[key];
    if (fallback !== undefined && fallback.length > 0) {
      return fallback;
    }
    return key;
  }

  static localeLabel(locale: string): string {
    if (locale === 'zh-TW') {
      return '繁體中文';
    }
    if (locale === 'en-US') {
      return 'English';
    }
    return '中文';
  }

  private static bumpLocaleRev(): void {
    const raw = AppStorage.get<number>(STORE_KEYS.localeRev);
    let next = 1;
    if (raw !== undefined && raw !== null) {
      next = Number(`${raw}`) + 1;
      if (Number.isNaN(next)) {
        next = 1;
      }
    }
    AppStorage.setOrCreate(STORE_KEYS.localeRev, next);
  }

  private static normalize(locale: string): string {
    if (locale === 'zh-TW') {
      return 'zh-TW';
    }
    if (locale === 'en-US') {
      return 'en-US';
    }
    return 'zh-CN';
  }

  private static tableOf(locale: string): Record<string, string> {
    if (locale === 'zh-TW') {
      return ZH_TW;
    }
    if (locale === 'en-US') {
      return EN_US;
    }
    return ZH_CN;
  }
}
